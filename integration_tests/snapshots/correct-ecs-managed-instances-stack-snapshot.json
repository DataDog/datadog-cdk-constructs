  "sampleDaemonTaskDefinition2A825C5A": {
   "Type": "AWS::ECS::DaemonTaskDefinition",
   "Properties": {
    "ContainerDefinitions": [
     {
      "Cpu": 256,
      "Environment": [
       {
        "Name": "ECS_MANAGED_INSTANCES",
        "Value": "true"
       },
       {
        "Name": "DD_INSTALL_INFO_TOOL",
        "Value": "cdk"
       },
       {
        "Name": "DD_INSTALL_INFO_TOOL_VERSION",
        "Value": "datadog-cdk-constructs"
       },
       {
        "Name": "DD_INSTALL_INFO_INSTALLER_VERSION",
        "Value": "X.X.X"
       },
       {
        "Name": "DD_API_KEY",
        "Value": "exampleApiKey"
       },
       {
        "Name": "DD_ENV",
        "Value": "prod"
       },
       {
        "Name": "DD_CRI_SOCKET_PATH",
        "Value": "/var/run/containerd/containerd.sock"
       },
       {
        "Name": "DD_DOGSTATSD_ORIGIN_DETECTION",
        "Value": "true"
       },
       {
        "Name": "DD_DOGSTATSD_ORIGIN_DETECTION_CLIENT",
        "Value": "true"
       },
       {
        "Name": "DD_DOGSTATSD_TAG_CARDINALITY",
        "Value": "orchestrator"
       },
       {
        "Name": "DD_APM_ENABLED",
        "Value": "true"
       },
       {
        "Name": "DD_ECS_TASK_COLLECTION_ENABLED",
        "Value": "true"
       },
       {
        "Name": "DD_DOGSTATSD_URL",
        "Value": "unix:///var/run/datadog/dsd.socket"
       },
       {
        "Name": "DD_TRACE_AGENT_URL",
        "Value": "unix:///var/run/datadog/apm.socket"
       }
      ],
      "Essential": true,
      "HealthCheck": {
       "Command": [
        "CMD-SHELL",
        "agent health"
       ],
       "Interval": 30,
       "Retries": 3,
       "StartPeriod": 15,
       "Timeout": 5
      },
      "Image": "public.ecr.aws/datadog/agent:latest",
      "Memory": 512,
      "MountPoints": [
       {
        "ContainerPath": "/var/run/containerd/containerd.sock",
        "ReadOnly": true,
        "SourceVolume": "containerd_sock"
       },
       {
        "ContainerPath": "/host/proc",
        "ReadOnly": true,
        "SourceVolume": "proc"
       },
       {
        "ContainerPath": "/host/sys/fs/cgroup",
        "ReadOnly": true,
        "SourceVolume": "cgroup"
       },
       {
        "ContainerPath": "/var/run/datadog",
        "ReadOnly": false,
        "SourceVolume": "dd-sockets"
       }
      ],
      "Name": "datadog-agent"
     }
    ],
    "ExecutionRoleArn": {
     "Fn::GetAtt": [
      "sampleDaemonTaskDefinitionExecutionRole8791DC54",
      "Arn"
     ]
    },
    "Family": "datadog-agent-daemon",
    "Tags": [
     {
      "Key": "dd_cdk_construct",
      "Value": "vX.XX.X"
     }
    ],
    "TaskRoleArn": {
     "Fn::GetAtt": [
      "sampleDaemonTaskDefinitionTaskRole2465A95E",
      "Arn"
     ]
    },
    "Volumes": [
     {
      "Host": {
       "SourcePath": "/var/run/containerd/containerd.sock"
      },
      "Name": "containerd_sock"
     },
     {
      "Host": {
       "SourcePath": "/proc/"
      },
      "Name": "proc"
     },
     {
      "Host": {
       "SourcePath": "/sys/fs/cgroup/"
      },
      "Name": "cgroup"
     },
     {
      "Host": {
       "SourcePath": "/var/run/datadog"
      },
      "Name": "dd-sockets"
     }
    ]
   },
   "Metadata": {
    "aws:cdk:path": "ecs-managed-instances-stack/sampleDaemonTaskDefinition/TaskDefinition"
   }
  },
